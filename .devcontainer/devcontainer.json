{
  "name": "hugo-conference-site",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22"
    },
    "ghcr.io/devcontainers/features/hugo:1": {
      "extended": true,
      "version": "0.165.0"
    }
  },

  "appPort": [1313],
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo server",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "budparr.language-hugo-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "tasks": [
        {
          "label": "Hugo: server log",
          "type": "shell",
          "command": "tail -f /tmp/hugo-server.log",
          "runOptions": { "runOn": "folderOpen" },
          "isBackground": true,
          "problemMatcher": []
        }
      ]
    }
  },

  "postStartCommand": "hugo server --bind 0.0.0.0 --port 1313 2>&1 | tee /tmp/hugo-server.log"
}
