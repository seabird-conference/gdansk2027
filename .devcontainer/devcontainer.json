{
  "name": "hugo-conference-site",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.22"
    }
  },

  "onCreateCommand": "curl -fsSL https://github.com/gohugoio/hugo/releases/download/v0.140.0/hugo_extended_0.140.0_linux-amd64.deb -o /tmp/hugo.deb && sudo dpkg -i /tmp/hugo.deb",

  "postCreateCommand": "npm install",

  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo server",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "budparr.language-hugo-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },

  "postStartCommand": "hugo version"
}
